# Адрес сайта — SITE_ADDRESS из .env (на сервере: aident24.ru, www.aident24.ru).
# С доменом Caddy сам получает сертификат Let's Encrypt и переводит http на https.
# Не задан — :80 без HTTPS (локальный стенд)
{$SITE_ADDRESS::80} {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; font-src 'self'; script-src 'self' https://cdn.tailwindcss.com 'unsafe-inline' 'unsafe-eval'; connect-src 'self' blob: data: ws: wss:;"
    }

    # www → основной домен: Origin WebSocket чата должен совпадать с SITE_ORIGIN
    @www header_regexp www Host ^www\.(.+)$
    redir @www https://{re.www.1}{uri} permanent

    # Явные MIME-типы для 3D-моделей
    @gltf path *.gltf *.glb
    header @gltf Content-Type application/octet-stream

    # FastAPI (внутри контейнера порт 8000, имя сервиса api)
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /ws {
        reverse_proxy api:8000
    }
    handle /ws/* {
        reverse_proxy api:8000
    }

    # Счета и КП — только через Django с проверкой владельца
    # (/cart/invoice/<номер>/ и /chat/quote/<id>/)
    handle /media/invoices/* {
        respond 404
    }
    handle /media/quotes/* {
        respond 404
    }

    # Media — Caddy отдаёт из смонтированного тома (быстрее, чем через Django)
    # Загруженные файлы не перезаписываются (повтор имени получает суффикс), поэтому кэш на месяц:
    # без него браузер на каждой странице заново спрашивает сервер про каждую картинку
    handle /media/* {
        root * /srv
        header Cache-Control "public, max-age=2592000"
        file_server
    }

    # Всё остальное — Django (имя сервиса catalog, порт 8000)
    handle {
        reverse_proxy catalog:8000
    }
}

# Панель управления бизнесом — отдельный хост с неугадываемым именем (PANEL_ADDRESS из .env).
# Без PANEL_ADDRESS работает только на локальном стенде: http://panel.localhost
# Django отдаёт на нём одну панель, остальные адреса сайта там не существуют.
{$PANEL_ADDRESS:http://panel.localhost} {
    encode gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        X-Robots-Tag "noindex, nofollow"
    }

    handle /media/* {
        respond 404
    }

    handle {
        reverse_proxy catalog:8000
    }
}
