# Полный список переменных окружения без значений. Скопировать в .env и заполнить.

# --- Django (catalog) ---
DJANGO_SECRET_KEY=
DEBUG=
DJANGO_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# Секретный путь к админке
DJANGO_ADMIN_URL=
SITE_ORIGIN=
LOG_LEVEL=
# Домены для Caddy (сертификат HTTPS): aident24.ru, www.aident24.ru; пусто — :80 без HTTPS
SITE_ADDRESS=
# Панель управления бизнесом: отдельный хост с неугадываемым именем, например p-3f9c1a7e5b24.aident24.ru.
# PANEL_HOST — для Django, PANEL_ADDRESS — для Caddy (локально: panel.localhost и http://panel.localhost).
# PANEL_HOST пуст — панель выключена. DNS-запись на хост нужна до запуска (иначе Caddy не получит сертификат)
PANEL_HOST=
PANEL_ADDRESS=

# --- PostgreSQL ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
# Отдельная роль БД для сервиса api
API_DB_USER=
API_DB_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=
REDIS_URL=

# --- SMS с кодом входа ---
# notificore — на проде; console — код пишется в лог (локальный стенд)
SMS_PROVIDER=
# Ключ API Notificore (live_…)
SMS_API_KEY=
# Имя отправителя и id одобренного шаблона 2FA в Notificore
SMS_SENDER=
SMS_TEMPLATE_ID=

# --- Оплата ---
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_LINK_ENABLED=

# --- Почта: SMTP Яндекса ---
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_SSL=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
MANAGER_EMAIL=
NOTIFY_EMAILS=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ссылки в админку в уведомлениях (по умолчанию True)
TELEGRAM_ADMIN_LINKS=

# --- ИИ-консультант ---
# Показывать виджет чата на сайте (catalog): True / False
CHAT_WIDGET_ENABLED=
# Дальше — только сервис api
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Прокси до Claude API: задаётся одна из двух
ANTHROPIC_PROXY_URL=
ANTHROPIC_BASE_URL=
AGENT_EFFORT=
AGENT_MAX_TOKENS=
AGENT_MAX_TOOL_ROUNDS=
AGENT_PREFIX_MISMATCH=
# Лимиты и бюджет; пусто — по умолчанию: 2000 символов, 6 в минуту, 50 в сутки, 60 в диалоге, $20 в сутки
CHAT_MAX_MESSAGE_LENGTH=
CHAT_MESSAGES_PER_MINUTE=
CHAT_MESSAGES_PER_DAY=
CHAT_MESSAGES_PER_CONVERSATION=
# Сообщений в сутки с одного IP; пусто — 150
CHAT_MESSAGES_PER_IP_PER_DAY=
CHAT_DAILY_BUDGET_USD=
