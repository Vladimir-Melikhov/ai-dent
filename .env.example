# Полный список переменных окружения без значений. Скопировать в .env и заполнить.
# Описание — ТЗ.md, §15.

# --- Django (catalog) ---
DJANGO_SECRET_KEY=
DEBUG=
DJANGO_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# Секретный путь к админке
DJANGO_ADMIN_URL=
SITE_ORIGIN=
LOG_LEVEL=
# Домены для Caddy (сертификат HTTPS): aident24.ru, www.aident24.ru; пусто — :80 без HTTPS
SITE_ADDRESS=

# --- PostgreSQL ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
# Отдельная роль БД для сервиса api (ТЗ §5.4)
API_DB_USER=
API_DB_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=
REDIS_URL=

# --- SMS ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# --- Оплата ---
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_LINK_ENABLED=

# --- Почта: SMTP Яндекса (ТЗ §15) ---
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_SSL=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
MANAGER_EMAIL=
NOTIFY_EMAILS=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ссылки в админку в уведомлениях (по умолчанию True)
TELEGRAM_ADMIN_LINKS=

# --- ИИ-консультант ---
# Показывать виджет чата на сайте (catalog): True / False
CHAT_WIDGET_ENABLED=
# Дальше — только сервис api
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Прокси до Claude API: задаётся одна из двух
ANTHROPIC_PROXY_URL=
ANTHROPIC_BASE_URL=
AGENT_EFFORT=
AGENT_MAX_TOKENS=
AGENT_MAX_TOOL_ROUNDS=
AGENT_PREFIX_MISMATCH=
# Лимиты и бюджет (ТЗ §7.8); пусто — по умолчанию: 2000 символов, 6 в минуту, 50 в сутки, 60 в диалоге, $20 в сутки
CHAT_MAX_MESSAGE_LENGTH=
CHAT_MESSAGES_PER_MINUTE=
CHAT_MESSAGES_PER_DAY=
CHAT_MESSAGES_PER_CONVERSATION=
CHAT_DAILY_BUDGET_USD=
